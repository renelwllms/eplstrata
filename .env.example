# SECURITY_HEADERS_MODE="relaxed" # or "strict"
# CORS_ALLOWED_ORIGINS="https://app.strata.edgepoint.co.nz"
# UPLOAD_MAX_BYTES="31457280"
# UPLOAD_ALLOWED_MIME="image/jpeg,image/png,image/webp,application/pdf"
SERVER_LOG_LEVEL="info"
RATE_LIMIT_MAX="120"
RATE_LIMIT_WINDOW_MS="60000"
