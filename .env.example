DATABASE_URL="postgresql://postgres:password@localhost:5432/edgepoint_strata?schema=public"
NEXTAUTH_URL="https://app.strata.edgepoint.co.nz"
NEXTAUTH_SECRET="replace-with-strong-secret"
APP_BASE_URL="https://app.strata.edgepoint.co.nz"
