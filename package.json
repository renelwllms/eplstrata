{
  "name": "edgepoint-strata",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n app,api,marketing \"PORT=3002 next dev -p 3002\" \"APP_MODE=api PORT=3003 next dev -p 3003\" \"npm --prefix apps/marketing run dev\"",
    "dev:app": "PORT=3002 next dev -p 3002",
    "dev:api": "APP_MODE=api PORT=3003 next dev -p 3003",
    "dev:marketing": "npm --prefix apps/marketing run dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "prisma db seed",
    "test:tenant": "tsx scripts/tenant-check.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcrypt": "^6.0.0",
    "@types/nodemailer": "^7.0.9",
    "autoprefixer": "^10.4.24",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "form-data": "^4.0.5",
    "lucide-react": "^0.563.0",
    "mailgun.js": "^12.7.0",
    "next": "^16.1.6",
    "next-auth": "^4.24.13",
    "next-pwa": "^5.6.0",
    "nodemailer": "^7.0.13",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "prisma": "^5.20.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  }
}
